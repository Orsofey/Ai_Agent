{
  "manifest_version": 3,
  "name": "Андрей — голосовой ассистент",
  "short_name": "Андрей",
  "version": "1.0.0",
  "description": "Связывает браузер с ассистентом «Андрей»: открывает сайты в уже открытых вкладках и управляет плеерами голосом.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Андрей" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"]
}
